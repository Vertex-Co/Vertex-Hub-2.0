VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Alternativa para projetos Supabase que ainda usam a chave anon:
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Mercado Pago — use exclusivamente credenciais de teste nesta etapa.
VITE_MERCADO_PAGO_PUBLIC_KEY=TEST-your-public-key
# Somente servidor/Edge Functions (nunca prefixar com VITE_):
MERCADO_PAGO_ACCESS_TOKEN=TEST-your-access-token
MERCADO_PAGO_WEBHOOK_SECRET=your-test-webhook-secret
MERCADO_PAGO_MODE=test
