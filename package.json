{
  "name": "dashboard-financeiro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:sites": "npm run build && node scripts/package-sites.mjs",
    "test:onboarding": "node scripts/verify-atomic-onboarding.mjs",
    "test:permissions": "node scripts/verify-permissions.mjs",
    "test:security": "node scripts/verify-security.mjs",
    "test:donation": "node scripts/verify-static-pix.mjs",
    "test:email": "node scripts/verify-email.mjs",
    "test:email-presets": "node scripts/verify-email-presets.mjs",
    "email:test": "node --env-file-if-exists=.env.local scripts/test-email.mjs",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@supabase/supabase-js": "^2.105.3",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "recharts": "^3.1.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "supabase": "^2.110.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "vite": "^7.1.3"
  }
}
